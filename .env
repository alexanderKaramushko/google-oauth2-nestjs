# Идентификатор приложения для OAuth.
CLIENT_ID='60072192815-e9gp1tp69odvjg7tdtqconivbnuud0v2.apps.googleusercontent.com'

# Секрет приложения для OAuth.
# На проде берется из Vault или окружения раннера или из серверного .env.
# В режиме локальной разработки можно заменить test на актуальное значение вручную.
CLIENT_SECRET='test'

# Хост сервиса (слушаем все интерфейсы)
SERVICE_HOST=0.0.0.0

# Порт сервиса
SERVICE_PORT=3001

# Хост, на который происходит редирект
# c передачей code
OAUTH_CALLBACK_HOST='http://localhost:3001'

# Клиентские приложения, куда происходит редирект после OAUTH_CALLBACK_HOST
OAUTH_CLIENT_APPS={"goals":"http://localhost:3000/app"}

# Секрет для подписи и проверки OAuth state
OAUTH_STATE_SECRET='test'

# Хост базы даных
MONGO_DB_HOST=localhost

# Название базы данных
MONGO_DB_NAME=auth

# Порт базы данных
MONGO_DB_PORT=27017

# Хост микросервиса (слушаем все интерфейсы)
MICROSERVICE_HOST=0.0.0.0

# Порт микросервиса
MICROSERVICE_PORT=3002
